# =====================================================================
# TurismoIA San Martín - Plantilla de Variables de Entorno (.env.example)
# =====================================================================
# INSTRUCCIONES:
# 1. Copia este archivo con el nombre '.env':
#      cp .env.example .env
# 2. Modifica los valores con las credenciales reales de tu servidor/entorno.
# 3. Nunca subas el archivo '.env' a repositorios públicos.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Configuración de Base de Datos PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_DB=turismoia
DB_PORT=5434
DB_SCHEMA=turismo

# ---------------------------------------------------------------------
# 2. Configuración del Servicio REST FastAPI
# ---------------------------------------------------------------------
API_PORT=8000
DEBUG=false
MODEL_PATH=../ml_engine/models/modelo_recomendador_sanmartin.pkl

# URL de conexión SQLAlchemy + asyncpg:
# - En Docker Compose (comunicación interna entre contenedores):
#     DATABASE_URL=postgresql+asyncpg://postgres:tu_password_seguro_aqui@db:5432/turismoia
# - Fuera de Docker (ejecución local en tu máquina):
#     DATABASE_URL=postgresql+asyncpg://postgres:tu_password_seguro_aqui@localhost:5434/turismoia
DATABASE_URL=postgresql+asyncpg://postgres:tu_password_seguro_aqui@db:5432/turismoia
